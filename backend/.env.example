# 通义千问 API Key (必须)
# 申请地址: https://dashscope.console.aliyun.com
DASHSCOPE_API_KEY=sk-71364233b04d4e4fb7ff11db3b8994f9

# 豆包 API Key (可选，如使用豆包模型)
DOUBAO_API_KEY=your_doubao_api_key_here

# Flask 配置
FLASK_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=5000

# LLM 配置
LLM_PROVIDER=qwen
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# RAG 配置
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5
RERANK_TOP_K=3
HYBRID_ALPHA=0.7

# Embedding 模型
BGE_MODEL=BAAI/bge-large-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-large

# CORS 配置 (多个域名用逗号分隔)
CORS_ORIGINS=*
